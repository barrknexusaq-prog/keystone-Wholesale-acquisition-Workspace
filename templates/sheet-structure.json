{
  "workspaceName": "Acquisition Workspace",
  "version": "3.1",
  "sheets": {
    "On Market Leads": {
      "description": "Track leads from Zillow, Redfin, MLS, and other on-market sources",
      "headerColor": "#1E3A5F",
      "columns": [
        { "name": "Lead ID", "type": "text", "width": 80, "autoGenerate": true, "format": "OM-YYMMDD-###" },
        { "name": "Date Added", "type": "date", "width": 100, "autoGenerate": true },
        { "name": "Source", "type": "dropdown", "width": 100, "options": ["Zillow", "Redfin", "Realtor.com", "MLS"] },
        { "name": "MLS #", "type": "text", "width": 100 },
        { "name": "Property Address", "type": "text", "width": 200 },
        { "name": "City", "type": "text", "width": 100 },
        { "name": "County", "type": "text", "width": 100 },
        { "name": "State", "type": "text", "width": 50, "default": "TX" },
        { "name": "Zip Code", "type": "text", "width": 70 },
        { "name": "Property Type", "type": "dropdown", "width": 100, "options": ["Single Family", "Multi Family", "Townhouse", "Condo", "Land", "Commercial", "Other"] },
        { "name": "Beds", "type": "number", "width": 50 },
        { "name": "Baths", "type": "number", "width": 50 },
        { "name": "Sqft", "type": "number", "width": 70 },
        { "name": "Year Built", "type": "number", "width": 70 },
        { "name": "List Price", "type": "currency", "width": 100 },
        { "name": "Days on Market", "type": "number", "width": 70 },
        { "name": "ARV Estimate", "type": "currency", "width": 100 },
        { "name": "Repair Estimate", "type": "currency", "width": 100 },
        { "name": "MAO", "type": "currency", "width": 100, "formula": "=(Q{row}*0.7)-R{row}" },
        { "name": "Offer Amount", "type": "currency", "width": 100 },
        { "name": "Qualified (Yes/No)", "type": "dropdown", "width": 80, "options": ["Yes", "No"], "default": "No" },
        { "name": "Passed to Team Lead (Yes/No)", "type": "dropdown", "width": 80, "options": ["Yes", "No"], "default": "No" },
        { "name": "Offer Made (Yes/No)", "type": "dropdown", "width": 80, "options": ["Yes", "No"], "default": "No" },
        { "name": "Contract Signed (Yes/No)", "type": "dropdown", "width": 80, "options": ["Yes", "No"], "default": "No" },
        { "name": "Status", "type": "dropdown", "width": 100, "options": ["New", "Contacted", "Analyzing", "Offer Pending", "Under Contract", "Closed", "Dead"], "default": "New" },
        { "name": "Notes", "type": "text", "width": 200 },
        { "name": "Agent Name", "type": "text", "width": 120 },
        { "name": "Agent Phone", "type": "phone", "width": 120 },
        { "name": "Listing URL", "type": "url", "width": 250 }
      ]
    },
    "Off Market Leads": {
      "description": "Track leads from wholesalers, agents, direct mail, and other off-market sources",
      "headerColor": "#2D5016",
      "columns": [
        { "name": "Lead ID", "type": "text", "width": 80, "autoGenerate": true, "format": "OF-YYMMDD-###" },
        { "name": "Date Added", "type": "date", "width": 100, "autoGenerate": true },
        { "name": "Source", "type": "dropdown", "width": 120, "options": ["Wholesaler", "Agent Referral", "Direct Mail", "Cold Call", "Driving for Dollars", "Probate", "Tax Lien", "Other"] },
        { "name": "Source Contact", "type": "text", "width": 120 },
        { "name": "Source Phone", "type": "phone", "width": 120 },
        { "name": "Source Email", "type": "email", "width": 150 },
        { "name": "Property Address", "type": "text", "width": 200 },
        { "name": "City", "type": "text", "width": 100 },
        { "name": "County", "type": "text", "width": 100 },
        { "name": "State", "type": "text", "width": 50, "default": "TX" },
        { "name": "Zip Code", "type": "text", "width": 70 },
        { "name": "Property Type", "type": "dropdown", "width": 100, "options": ["Single Family", "Multi Family", "Townhouse", "Condo", "Land", "Commercial", "Other"] },
        { "name": "Beds", "type": "number", "width": 50 },
        { "name": "Baths", "type": "number", "width": 50 },
        { "name": "Sqft", "type": "number", "width": 70 },
        { "name": "Year Built", "type": "number", "width": 70 },
        { "name": "Asking Price", "type": "currency", "width": 100 },
        { "name": "ARV Estimate", "type": "currency", "width": 100 },
        { "name": "Repair Estimate", "type": "currency", "width": 100 },
        { "name": "MAO", "type": "currency", "width": 100, "formula": "=(R{row}*0.7)-S{row}" },
        { "name": "Offer Amount", "type": "currency", "width": 100 },
        { "name": "Assignment Fee", "type": "currency", "width": 100 },
        { "name": "Qualified (Yes/No)", "type": "dropdown", "width": 80, "options": ["Yes", "No"], "default": "No" },
        { "name": "Passed to Team Lead (Yes/No)", "type": "dropdown", "width": 80, "options": ["Yes", "No"], "default": "No" },
        { "name": "Offer Made (Yes/No)", "type": "dropdown", "width": 80, "options": ["Yes", "No"], "default": "No" },
        { "name": "Contract Signed (Yes/No)", "type": "dropdown", "width": 80, "options": ["Yes", "No"], "default": "No" },
        { "name": "Status", "type": "dropdown", "width": 100, "options": ["New", "Contacted", "Analyzing", "Offer Pending", "Under Contract", "Closed", "Dead"], "default": "New" },
        { "name": "Motivation Level", "type": "dropdown", "width": 100, "options": ["Hot", "Warm", "Cold"] },
        { "name": "Seller Name", "type": "text", "width": 120 },
        { "name": "Seller Phone", "type": "phone", "width": 120 },
        { "name": "Notes", "type": "text", "width": 200 }
      ]
    },
    "Contract Pipeline": {
      "description": "Track deals under contract through closing",
      "headerColor": "#5C1F1F",
      "columns": [
        { "name": "Deal ID", "type": "text", "width": 100, "autoGenerate": true, "format": "CP-YYMMDD-HHMM" },
        { "name": "Original Lead ID", "type": "text", "width": 100 },
        { "name": "Date Under Contract", "type": "date", "width": 100 },
        { "name": "Property Address", "type": "text", "width": 200 },
        { "name": "City", "type": "text", "width": 100 },
        { "name": "County", "type": "text", "width": 100 },
        { "name": "State", "type": "text", "width": 50 },
        { "name": "Zip Code", "type": "text", "width": 70 },
        { "name": "Purchase Price", "type": "currency", "width": 100 },
        { "name": "ARV", "type": "currency", "width": 100 },
        { "name": "Repair Estimate", "type": "currency", "width": 100 },
        { "name": "Expected Profit", "type": "currency", "width": 100, "formula": "=J{row}-I{row}-K{row}" },
        { "name": "Earnest Money", "type": "currency", "width": 100 },
        { "name": "Inspection Period End", "type": "date", "width": 100 },
        { "name": "Close Date", "type": "date", "width": 100 },
        { "name": "Disposition Strategy", "type": "dropdown", "width": 120, "options": ["Assigned", "Double Close", "Wholetail", "Fix & Flip", "Buy & Hold", "Dead Deal"] },
        { "name": "Disposition Outcome", "type": "dropdown", "width": 120, "options": ["Assigned", "Double Close", "Wholetail", "Fix & Flip", "Buy & Hold", "Dead Deal"] },
        { "name": "Buyer Name", "type": "text", "width": 120 },
        { "name": "Buyer Phone", "type": "phone", "width": 120 },
        { "name": "Assignment Fee", "type": "currency", "width": 100 },
        { "name": "Final Sale Price", "type": "currency", "width": 100 },
        { "name": "Actual Profit", "type": "currency", "width": 100, "formula": "=U{row}-I{row}" },
        { "name": "Status", "type": "dropdown", "width": 100, "options": ["Under Contract", "Pending Close", "Closed", "Cancelled"] },
        { "name": "Title Company", "type": "text", "width": 150 },
        { "name": "Title Contact", "type": "text", "width": 120 },
        { "name": "Attorney", "type": "text", "width": 120 },
        { "name": "Notes", "type": "text", "width": 200 },
        { "name": "Days to Close", "type": "number", "width": 70, "formula": "=DAYS(O{row},C{row})" }
      ]
    },
    "Main Page": {
      "description": "Consolidated view of all leads from all sources",
      "headerColor": "#1A4D4D",
      "columns": [
        { "name": "Lead ID", "type": "text", "width": 80 },
        { "name": "Date Added", "type": "date", "width": 100 },
        { "name": "Lead Type", "type": "dropdown", "width": 100, "options": ["On Market", "Off Market"] },
        { "name": "Source", "type": "text", "width": 120 },
        { "name": "Property Address", "type": "text", "width": 200 },
        { "name": "City", "type": "text", "width": 100 },
        { "name": "County", "type": "text", "width": 100 },
        { "name": "Zip Code", "type": "text", "width": 70 },
        { "name": "Property Type", "type": "dropdown", "width": 100, "options": ["Single Family", "Multi Family", "Townhouse", "Condo", "Land", "Commercial", "Other"] },
        { "name": "List/Ask Price", "type": "currency", "width": 100 },
        { "name": "ARV", "type": "currency", "width": 100 },
        { "name": "MAO", "type": "currency", "width": 100 },
        { "name": "Qualified (Yes/No)", "type": "dropdown", "width": 80, "options": ["Yes", "No"] },
        { "name": "Passed to Team Lead (Yes/No)", "type": "dropdown", "width": 80, "options": ["Yes", "No"] },
        { "name": "Offer Made (Yes/No)", "type": "dropdown", "width": 80, "options": ["Yes", "No"] },
        { "name": "Contract Signed (Yes/No)", "type": "dropdown", "width": 80, "options": ["Yes", "No"] },
        { "name": "Disposition Outcome", "type": "text", "width": 120 },
        { "name": "Buyer Name", "type": "text", "width": 120 },
        { "name": "Final Sale Price", "type": "currency", "width": 100 },
        { "name": "Status", "type": "dropdown", "width": 100, "options": ["New", "Contacted", "Analyzing", "Offer Pending", "Under Contract", "Closed", "Dead"] },
        { "name": "Notes", "type": "text", "width": 200 }
      ]
    },
    "Zip Codes": {
      "description": "Target markets and performance tracking by zip code",
      "headerColor": "#4A1F5C",
      "columns": [
        { "name": "Zip Code", "type": "text", "width": 80 },
        { "name": "City", "type": "text", "width": 100 },
        { "name": "County", "type": "text", "width": 100 },
        { "name": "State", "type": "text", "width": 50 },
        { "name": "Market Status", "type": "dropdown", "width": 100, "options": ["Active", "Paused", "Retired"] },
        { "name": "Priority Level", "type": "dropdown", "width": 100, "options": ["High", "Medium", "Low"] },
        { "name": "Avg Home Value", "type": "currency", "width": 100 },
        { "name": "Avg Days on Market", "type": "number", "width": 80 },
        { "name": "Total Leads", "type": "number", "width": 80, "formula": "=COUNTIF('Main Page'!H:H,A{row})" },
        { "name": "Contracts Won", "type": "number", "width": 80, "formula": "=COUNTIFS('Main Page'!H:H,A{row},'Main Page'!P:P,\"Yes\")" },
        { "name": "Success Rate", "type": "percent", "width": 80, "formula": "=IF(I{row}>0,J{row}/I{row},0)" },
        { "name": "Notes", "type": "text", "width": 200 },
        { "name": "Last Updated", "type": "date", "width": 100 }
      ]
    },
    "Buyers List": {
      "description": "Buyer database imported from Dispo Workspace form responses",
      "headerColor": "#1F4A5C",
      "columns": [
        { "name": "Timestamp", "type": "date", "width": 140 },
        { "name": "Name", "type": "text", "width": 150 },
        { "name": "Phone number", "type": "phone", "width": 120 },
        { "name": "Email", "type": "email", "width": 180 },
        { "name": "Type of Buyer", "type": "dropdown", "width": 120, "options": ["Creative", "Cash", "Cash, Creative"] },
        { "name": "Asset Type", "type": "text", "width": 160, "note": "Multi-select: Multi-Family, Single Family, RV Parks, Mobile Home Parks, Land" },
        { "name": "Deal Preference", "type": "text", "width": 180, "note": "Multi-select: Creative Financing, Cash, Seller Finance, Subject to, Hybrid" },
        { "name": "Exit Strategy", "type": "text", "width": 140, "note": "Multi-select: Buy & Hold, Fix and Flip" },
        { "name": "Market", "type": "text", "width": 120, "note": "State abbreviations: FL, TN, TX" },
        { "name": "City, County, or Zip-code(s)", "type": "text", "width": 200 },
        { "name": "Criteria", "type": "text", "width": 250 }
      ]
    }
  },
  "monthlyGoals": {
    "leadsGenerated": 100,
    "leadsQualified": 50,
    "offersMade": 25,
    "contractsSigned": 5,
    "dealsClosed": 3,
    "revenueTarget": 50000
  },
  "kpiFormulas": {
    "leadToQualified": "Qualified Leads / Total Leads",
    "qualifiedToOffer": "Offers Made / Qualified Leads",
    "offerToContract": "Contracts Signed / Offers Made",
    "contractToClose": "Deals Closed / Contracts Signed",
    "overallConversion": "Deals Closed / Total Leads"
  }
}
